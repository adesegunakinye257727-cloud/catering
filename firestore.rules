rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Website content configuration (Cinematic Hero, etc.)
    match /websiteContent/{contentId} {
      allow read, write: if true;
    }

    // Default catch-all for testing connection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
